From fa23c098f1172321601f607a6aa4d2dd491a4ae8 Mon Sep 17 00:00:00 2001
From: Nosini <git@nosini.eu>
Date: Sun, 18 Oct 2026 01:29:24 +0200
Subject: [PATCH 1/4] winewayland.drv: Retire nested popup roles before their
 parent.

Reuse the release's popup traversal on every role teardown path, including
hiding and compositor dismissal, so nested descendants are retired first.
Remove the individual destruction-site calls now covered by clear_role.

Keep the window data lock while destroying a surface because traversal
visits surfaces belonging to other window threads. This replaces the
previous patch's child lists with the traversal already carried upstream.
---
 dlls/winewayland.drv/wayland_surface.c |  9 +++------
 dlls/winewayland.drv/waylanddrv.h      |  1 +
 dlls/winewayland.drv/window.c          | 13 ++++++++-----
 3 files changed, 12 insertions(+), 11 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 178e6db5..18fc1bfb 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -250,15 +250,9 @@ static void xdg_popup_handle_done(void *private, struct xdg_popup *xdg_popup)
      * The protocol does not explicitly prohibit this from occuring on ungrabbed popups. */
     WARN("Compositor dismissed popup hwnd=%p\n", hwnd);

-    /* the protocol requires us to destroy the xdg_popup */
-    xdg_popup_destroy(xdg_popup);
-
     if (!(data = wayland_win_data_get(hwnd))) return;
     if ((surface = data->wayland_surface) && surface->xdg_popup == xdg_popup)
-    {
-        surface->xdg_popup = NULL;
         wayland_surface_clear_role(surface);
-    }
     wayland_win_data_release(data);

     NtUserPostMessage(hwnd, WM_WINE_UPDATEWINDOWSTATE, 0, 0);
@@ -699,6 +693,9 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
 {
     TRACE("surface=%p\n", surface);

+    /* Retire descendants before their parent on every role teardown path. */
+    wayland_surface_reparent_popups(surface);
+
     /* some objects are shared between several roles */

     if (surface->wp_fractional_scale_v1)
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 0f85d16b..6f044ae5 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -458,6 +458,7 @@ void wayland_surface_make_subsurface(struct wayland_surface *surface,
 void wayland_surface_make_popup(struct wayland_surface *surface,
                                 struct wayland_surface *owner);
 void wayland_surface_clear_role(struct wayland_surface *surface);
+void wayland_surface_reparent_popups(struct wayland_surface *surface);
 void wayland_surface_attach_shm(struct wayland_surface *surface,
                                 struct wayland_shm_buffer *shm_buffer,
                                 HRGN surface_damage_region);
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 6fd579e4..b083869a 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -101,7 +101,13 @@ static void wayland_win_data_destroy(struct wayland_win_data *data)
     pthread_mutex_unlock(&win_data_mutex);

     if (data->stashed_client) client_surface_release(&data->stashed_client->client);
-    if (data->wayland_surface) wayland_surface_destroy(data->wayland_surface);
+    if (data->wayland_surface)
+    {
+        /* Role teardown visits surfaces belonging to other window threads. */
+        pthread_mutex_lock(&win_data_mutex);
+        wayland_surface_destroy(data->wayland_surface);
+        pthread_mutex_unlock(&win_data_mutex);
+    }
     if (data->window_contents) wayland_shm_buffer_unref(data->window_contents);
     free(data);
 }
@@ -179,7 +185,7 @@ static void reapply_cursor_clipping(void)
     NtUserSetThreadDpiAwarenessContext(context);
 }

-static void wayland_surface_reparent_popups(struct wayland_surface *surface)
+void wayland_surface_reparent_popups(struct wayland_surface *surface)
 {
     HWND hwnd = surface->hwnd;
     struct wayland_win_data *entry;
@@ -234,7 +240,6 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
          */
         data->wayland_surface = NULL;
         update_client_surfaces(data->hwnd);
-        wayland_surface_reparent_popups(surface);
         wayland_surface_destroy(surface);
     }

@@ -484,7 +489,6 @@ void WAYLAND_DestroyWindow(HWND hwnd)
     TRACE("%p\n", hwnd);

     if (!(data = wayland_win_data_get(hwnd))) return;
-    if (data->wayland_surface) wayland_surface_reparent_popups(data->wayland_surface);
     wayland_win_data_destroy(data);
 }

@@ -536,7 +540,6 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UIN

     if (!surface && data->wayland_surface)
     {
-        wayland_surface_reparent_popups(data->wayland_surface);
         wayland_surface_destroy(data->wayland_surface);
         data->wayland_surface = NULL;
     }
